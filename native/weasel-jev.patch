+void RimeWithWeaselHandler::JevContextReset(DWORD ipc_id) {
+  auto it = m_session_status_map.find(ipc_id);
+  if (m_disabled || it == m_session_status_map.end()) return;
+  rime_api->set_property(it->second.session_id, "jev_context", "pending");
+}
+
+bool RimeWithWeaselHandler::JevContextQuery(DWORD ipc_id) {
+  auto it = m_session_status_map.find(ipc_id);
+  if (m_disabled || !ipc_id || m_active_session != ipc_id || it == m_session_status_map.end()) return false;
+  auto session = it->second.session_id;
+  RIME_STRUCT(RimeStatus, status);
+  if (!rime_api->get_status(session, &status)) return false;
+  bool eligible = status.is_composing && !status.is_ascii_mode && status.schema_id &&
+                  std::string(status.schema_id) == "rime_ice_jev";
+  rime_api->free_status(&status);
+  if (!eligible) return false;
+  rime_api->set_property(session, "jev_context_query", std::to_string(++m_jev_serial).c_str());
+  char consent[4] = {};
+  return rime_api->get_property(session, "jev_context_consent", consent, sizeof(consent)) && std::string(consent) == "1";
+}
+
+bool RimeWithWeaselHandler::JevContextSet(DWORD ipc_id, const std::wstring& wire) {
+  auto it = m_session_status_map.find(ipc_id);
+  jev::Snapshot snapshot;
+  if (m_disabled || !ipc_id || m_active_session != ipc_id || it == m_session_status_map.end() || !jev::Parse(wire, snapshot)) return false;
+  if (snapshot.quality == L"exact" && !JevContextQuery(ipc_id)) return false;
+  rime_api->set_property(it->second.session_id, "jev_context", wtou8(wire).c_str());
+  return true;
+}
+
+bool RimeWithWeaselHandler::JevRefresh(DWORD ipc_id, EatLine eat) {
+  auto it = m_session_status_map.find(ipc_id);
+  if (m_disabled || !ipc_id || m_active_session != ipc_id || it == m_session_status_map.end())
+    return false;
+  auto session = it->second.session_id;
+  RIME_STRUCT(RimeStatus, status);
+  if (!rime_api->get_status(session, &status)) return false;
+  bool eligible = status.is_composing && !status.is_ascii_mode && status.schema_id &&
+                  std::string(status.schema_id) == "rime_ice_jev";
+  rime_api->free_status(&status);
+  if (!eligible) return false;
+  RIME_STRUCT(RimeContext, context);
+  if (!rime_api->get_context(session, &context)) return false;
+  eligible = context.menu.page_no == 0 && context.menu.highlighted_candidate_index == 0;
+  rime_api->free_context(&context);
+  if (!eligible) return false;
+  // This runs under the normal IPC mutex, never on a foreign Lua thread.
+  auto serial = std::to_string(++m_jev_serial);
+  rime_api->set_property(session, "jev_refresh", serial.c_str());
+  char ack[32] = {};
+  if (!rime_api->get_property(session, "jev_refresh_ack", ack, sizeof(ack)) || serial != ack)
+    return false;
+  _Respond(ipc_id, eat);
+  _UpdateUI(ipc_id);
+  return true;
+}
