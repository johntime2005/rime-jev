+
+// A timer only requests an edit session. Rime mutation and UI refresh happen
+// together on this TSF apartment, after Windows grants the document lock.
+class CJevEditSession : public CEditSession {
+ public:
+  CJevEditSession(WeaselTSF* tsf, ITfContext* context, unsigned long long generation)
+      : CEditSession(tsf, context), generation_(generation) {}
+  STDMETHODIMP DoEditSession(TfEditCookie ec) override {
+    return _pTextService->JevEdit(ec, _pContext, generation_);
+  }
+ private:
+  unsigned long long generation_;
+};
+
+void WeaselTSF::JevPoll() {
+  if (_jev_pending || !_status.composing || !_IsComposing() || !_pThreadMgr ||
+      _fTestKeyDownPending || _fTestKeyUpPending || _IsKeyboardDisabled() ||
+      (_isToOpenClose && !_IsKeyboardOpen())) return;
+  com_ptr<ITfDocumentMgr> doc;
+  com_ptr<ITfContext> context;
+  if (FAILED(_pThreadMgr->GetFocus(&doc)) || !doc || FAILED(doc->GetTop(&context)) ||
+      !context || context != _pEditSessionContext) return;
+  _jev_pending = true;
+  auto edit = new CJevEditSession(this, context, _jev_generation);
+  HRESULT result = E_FAIL;
+  HRESULT hr = context->RequestEditSession(_tfClientId, edit, TF_ES_ASYNC | TF_ES_READWRITE, &result);
+  edit->Release();
+  if (FAILED(hr) || FAILED(result)) _jev_pending = false;
+}
+
+HRESULT WeaselTSF::JevEdit(TfEditCookie ec, ITfContext* context, unsigned long long generation) {
+  _jev_pending = false;
+  if (generation != _jev_generation || !_pThreadMgr || !_IsComposing() ||
+      !_status.composing || _fTestKeyDownPending || _fTestKeyUpPending ||
+      _IsKeyboardDisabled() || (_isToOpenClose && !_IsKeyboardOpen())) return S_OK;
+  com_ptr<ITfDocumentMgr> doc;
+  com_ptr<ITfContext> focused;
+  if (FAILED(_pThreadMgr->GetFocus(&doc)) || !doc || FAILED(doc->GetTop(&focused)) ||
+      !focused || focused.p != context || focused != _pEditSessionContext) return S_OK;
+  DWORD pid = 0;
+  GetWindowThreadProcessId(GetForegroundWindow(), &pid);
+  if (pid != GetCurrentProcessId()) return S_OK;
+  // Moving the application caret invalidates a queued refresh, even if Rime
+  // still has the old pinyin. Compare ranges; never read surrounding text.
+  TF_SELECTION selection = {};
+  ULONG fetched = 0;
+  if (!_jev_selection || FAILED(context->GetSelection(ec, TF_DEFAULT_SELECTION, 1, &selection, &fetched)) || fetched != 1)
+    return S_OK;
+  com_ptr<ITfRange> current;
+  current.Attach(selection.range);
+  LONG start = 1, end = 1;
+  if (FAILED(current->CompareStart(ec, _jev_selection, TF_ANCHOR_START, &start)) ||
+      FAILED(current->CompareEnd(ec, _jev_selection, TF_ANCHOR_END, &end)) || start || end) {
+    ++_jev_generation;
+    m_client.FocusOut();
+    return S_OK;
+  }
+  if (m_client.JevRefresh()) return DoEditSession(ec);
+  return S_OK;
+}
