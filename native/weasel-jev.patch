+      _IsKeyboardDisabled() || (_isToOpenClose && !_IsKeyboardOpen())) return S_OK;
+  com_ptr<ITfDocumentMgr> doc;
+  com_ptr<ITfContext> focused;
+  if (FAILED(_pThreadMgr->GetFocus(&doc)) || !doc || FAILED(doc->GetTop(&focused)) ||
+      !focused || focused.p != context || focused != _pEditSessionContext) return S_OK;
