+      com_ptr<ITfRange> anchor;
+      if (_pComposition && SUCCEEDED(_pComposition->GetRange(&anchor)))
+        snapshot = jev::Read(context, anchor, ec);
+    }
+    jev::Snapshot previous;
+    const auto observed_generation = _jev_generation;
+    if (jev::Parse(_jev_context_wire, previous) && previous.quality == snapshot.quality && previous.text == snapshot.text) {
+      snapshot.stamp = previous.stamp;
+    } else {
+      snapshot.stamp = std::to_wstring(GetCurrentProcessId()) + L"-" +
+          std::to_wstring(GetTickCount64()) + L"-" + std::to_wstring(++_jev_context_serial);
+    }
+    // Capture/recheck and candidate application share this TSF document lock.
+    // A new stamp cancels Lua's old request before any result can be consumed.
+    auto wire = snapshot.Wire();
+    if (!m_client.JevContextSet(wire)) return S_OK;
+    if (observed_generation != _jev_generation) return S_OK;
+    _jev_context_wire = wire;
+  }
+  if (m_client.JevRefresh()) return DoEditSession(ec);
+  return S_OK;
+}
